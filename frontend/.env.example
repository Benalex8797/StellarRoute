# Feature flags
NEXT_PUBLIC_FLAG_ROUTES_BETA=false
NEXT_PUBLIC_FLAG_BATCH_SWAPS=false
NEXT_PUBLIC_FLAG_SWAP_UI_V2=false

# Network + API (local development — localhost allowed)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_API_URL_TESTNET=https://api.your-staging-host
# NEXT_PUBLIC_API_URL_MAINNET=https://api.your-mainnet-host

# Production / Vercel: set a public HTTPS API URL (never localhost).
# STELLARROUTE_ENV=production
